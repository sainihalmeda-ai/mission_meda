# Copy this file to .env and fill it in (the launcher does this for you on first run).

# Which AI brain: "gemini" (free tier) or "claude" (paid, smartest).
MEDA_PROVIDER=gemini

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude key from https://platform.claude.com (only if MEDA_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Your first name. The crew calls you by it.
MEDA_OWNER_NAME=Sai

# Passcode the app asks for. Required for phone mode (6+ characters).
MEDA_PASSCODE=

# The folder that holds your coding projects. Lochu only works inside it.
MEDA_PROJECTS_DIR=~/projects

# Model name. Leave empty for the default (gemini-3.5-flash-lite or claude-opus-5-5).
# If Gemini says the model is unknown, pick a free model listed in Google AI Studio.
MEDA_MODEL=

# Jyothi's limits.
MEDA_DAILY_REQUEST_LIMIT=1500
MEDA_DAILY_BUDGET_USD=2.00
MEDA_AGENT_TOKENS_PER_HOUR=200000
MEDA_COOLDOWN_MINUTES=10
